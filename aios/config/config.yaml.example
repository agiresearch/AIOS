# Global Configuration for AIOS

# API Keys Configuration
api_keys:
  openai: ""    # OpenAI API key
  gemini: ""    # Google Gemini API key
  groq: ""      # Groq API key
  anthropic: "" # Anthropic API key
  huggingface:
    auth_token: ""  # Your HuggingFace auth token for authorized models
    cache_dir: ""   # Your cache directory for saving huggingface models

# LLM Configuration
llms:
  models:

    # One model per backend is enough to run the four-tab demo described in
    # scripts/README.md: the terminal picks its priority from the backend it
    # submits to -- ollama -> high, gemini -> normal, groq -> low.

    # OpenAI Models
    # - name: "gpt-4o-mini"
    #   backend: "openai"

    # - name: "gpt-4o"
    #   backend: "openai"


    # Google Models
    # - name: "gemini-2.0-flash"
    #   backend: "gemini"


    # Anthropic Models
    # - name: "claude-3-opus"
    #   backend: "anthropic"

    # Groq Models  ->  the `groq` tab, which submits at LOW priority
    # - name: "openai/gpt-oss-20b"
    #   backend: "groq"

    # Ollama Models
    - name: "qwen3:1.7b"
      backend: "ollama"
      hostname: "http://localhost:11434" # Make sure to run ollama server

    - name: "qwen3:4b"
      backend: "ollama"
      hostname: "http://localhost:11434"

    # HuggingFace Models
    # - name: "meta-llama/Llama-3.1-8B-Instruct"
    #   backend: "huggingface"
    #   max_gpu_memory: {0: "48GB"}  # GPU memory allocation
    #   eval_device: "cuda:0"  # Device for model evaluation

    # vLLM Models
    # To use vllm as backend, you need to install vllm and run the vllm server https://docs.vllm.ai/en/latest/serving/openai_compatible_server.html
    # An example command to run the vllm server is:
    # vllm serve meta-llama/Llama-3.2-3B-Instruct --port 8091
    # - name: "meta-llama/Llama-3.1-8B-Instruct"
    #  backend: "vllm"
    #  hostname: "http://localhost:8091"

  router:
    strategy: "sequential"
    bootstrap_url: "https://drive.google.com/file/d/1SF7MAvtnsED7KMeMdW3JDIWYNGPwIwL7/view"

  log_mode: "console" # choose from [console, file]
  use_context_manager: false

memory:
  log_mode: "console" # choose from [console, file]
  provider: "in-house"  # Options: in-house, mem0, zep

  # Personalization settings (all opt-in, disabled by default)
  # auto_extract: saves conversation turns as memories after each chat LLM call
  # auto_inject: retrieves relevant memories and prepends them before each chat LLM call
  auto_extract: false
  auto_inject: false
  relevance_threshold: 0.5     # Minimum similarity score for memory injection
  max_injected_memories: 5     # Max memories to inject per LLM call
  max_memory_tokens: 1500      # Token budget for injected memory block

  # Memory write barrier — holds user_id-scoped retrievals until in-flight
  # create_memory operations for the same user_id commit. Defaults are coded
  # in MemoryWriteBarrier.__init__, so omitting this section is safe.
  write_barrier:
    enabled: true        # set false to disable the barrier
    timeout_ms: 5000     # max wait per retrieval

  # Mem0 provider configuration (used when provider: "mem0")
  mem0:
    api_key: ""  # Optional: for Mem0 cloud
    user_id: "default"
    # LLM config for Mem0 fact extraction. When omitted or empty, the
    # kernel automatically uses the same model as the assistant agent
    # (propagated from the runtime LLMQuery.llms field). Set this only
    # if you want Mem0 to use a *different* model from the assistant.
    # llm:
    #   provider: "ollama"
    #   config:
    #     model: "qwen2.5:7b"
    #     ollama_base_url: "http://localhost:11434"
    embedder:
      provider: "ollama"
      config:
        model: "nomic-embed-text"
        ollama_base_url: "http://localhost:11434"
    vector_store:
      provider: "chroma"
      config:
        collection_name: "mem0_memories"
        # path: ".mem0/chroma"  # ChromaDB persistence directory (default: .mem0/chroma)

  # Zep provider configuration (used when provider: "zep")
  zep:
    api_key: ""  # Zep Cloud API key, or leave empty for self-hosted
    base_url: "http://localhost:8000"  # For self-hosted Zep; remove for Zep Cloud
    session_id: "default"
storage:
  root_dir: "root"
  use_vector_db: true

tool:
  # Optional. If omitted, AIOS defaults to aios/tool/mcp_server.py.
  mcp_server_script_path: "aios/tool/mcp_server.py"

scheduler:
  log_mode: "console" # choose from [console, file]

  # Scheduling policy: which agent gets the LLM next.
  #   fifo        - first come, first served, batched (default; historical behaviour)
  #   round_robin - each syscall gets a fixed time slice
  #   priority    - highest priority first, with aging so low-priority agents
  #                 cannot be starved (see docs/scheduling/priority_scheduling.md)
  # When omitted, the previous implicit choice is kept: round_robin if
  # llms.use_context_manager is true, otherwise fifo. Aliases fcfs, rr and
  # prio are also accepted.
  policy: "fifo"

  # Options for `policy: fifo`
  fifo:
    batch_interval: 1.0   # seconds to collect LLM requests before dispatching

  # Options for `policy: round_robin`
  round_robin:
    time_slice: 1.0       # seconds each syscall may run

  # Options for `policy: priority`
  priority:
    # Dispatch rounds a waiting syscall needs to gain one priority level.
    # A low-priority request therefore reaches the top level after
    # 2 * aging_interval rounds, which is the worst-case wait caused by
    # priority (settings must be >= 1).
    aging_interval: 5
    # Level assumed when a syscall carries no priority: high | normal | low.
    default_priority: "normal"

agent_factory:
  log_mode: "console" # choose from [console, file]
  max_workers: 64

server:
  host: "localhost"
  port: 8000
